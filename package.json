{
  "name": "a11y-typed-aria",
  "version": "0.1.0",
  "description": "TypeScript-first ARIA types with compile-time validation for roles and attributes",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "keywords": [
    "typescript",
    "aria",
    "accessibility",
    "a11y",
    "types",
    "wai-aria",
    "type-safe",
    "compile-time",
    "validation",
    "react",
    "web-components",
    "wcag"
  ],
  "author": "Gayathri Devi N",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gayathri1462/a11y-typed-aria.git"
  },
  "homepage": "https://github.com/gayathri1462/a11y-typed-aria#readme",
  "bugs": {
    "url": "https://github.com/gayathri1462/a11y-typed-aria/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "tsd --files 'tests/**/*.test-d.ts'",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "publish-package": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "tsd": "^0.30.0",
    "typescript": "^5.3.0"
  }
}